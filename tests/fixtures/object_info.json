 "CreateVideo": {
  "input": {
   "optional": {
    "audio": [
     "AUDIO",
     {
      "tooltip": "The audio to add to the video."
     }
    ],
    "bit_depth": [
     "COMBO",
     {
      "default": "auto",
      "multiselect": false,
      "options": [
       "auto",
       8,
       10
      ],
      "tooltip": "Auto uses 8-bit for sRGB and 10-bit for HDR. Explicit 8-bit and 10-bit choices are independent of colorspace."
     }
    ],
    "codec": [
     "COMBO",
     {
      "advanced": true,
      "default": "none",
      "multiselect": false,
      "options": [
       "none",
       "auto",
       "h264",
       "av1"
      ],
      "tooltip": "Optionally encode the video immediately. None keeps the images in tensor form; Auto uses H.264."
     }
    ],
    "color_space": [
     "COMBO",
     {
      "default": "sRGB",
      "multiselect": false,
      "options": [
       "sRGB",
       "HDR",
       "HDR PQ"
      ],
      "tooltip": "Colorspace of the input images. HDR selects BT.2020/HLG and HDR PQ selects BT.2020/PQ."
     }
    ]
   },
   "required": {
    "fps": [
     "FLOAT",
     {
      "default": 30.0,
      "max": 120.0,
      "min": 1.0,
      "step": 1.0
     }
    ],
    "images": [
     "IMAGE",
     {
      "tooltip": "The images to create a video from."
     }
    ]
   }
  },
  "output": [
   "VIDEO"
  ]
 },
